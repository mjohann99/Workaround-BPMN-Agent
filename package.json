{
  "name": "workaround-check",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "dev:local-node": "set PATH=%CD%\\.tools\\node-v20.17.0-win-x64;%PATH% && .\\.tools\\node-v20.17.0-win-x64\\npm.cmd run dev",
    "test:local-node": "set PATH=%CD%\\.tools\\node-v20.17.0-win-x64;%PATH% && .\\.tools\\node-v20.17.0-win-x64\\npm.cmd test",
    "build:local-node": "set PATH=%CD%\\.tools\\node-v20.17.0-win-x64;%PATH% && .\\.tools\\node-v20.17.0-win-x64\\npm.cmd run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
